# Copy to .env for local runs. Any OpenAI-compatible provider works.
API_KEY=paste-your-API-key-here
API_BASE=https://generativelanguage.googleapis.com/v1beta/openai/
MODEL_NAME=gemini-3.5-flash-lite
TARGET_LANGUAGE=Hindi
# APP_PASSWORD=choose-one

# Timing heuristic (calibrate with a stopwatch)
TIMING_UNIT=syllables
MAX_SYLLABLES_PER_SEC=6.0
MAX_WORDS_PER_SEC=3.0
TIMING_GRACE_SEC=0.3

# Cost estimate in USD per 1M tokens (0 on a free tier)
PRICE_IN_PER_M=0
PRICE_OUT_PER_M=0

# Offline testing with a fake model:  API_BASE=mock
